step "supabase-run-migrations" {
    name = "Supabase - Run Migrations"

    action {
        properties = {
            Octopus.Action.Template.Id = "ActionTemplates-10"
            Octopus.Action.Template.Version = "1"
            SupabaseAccessToken = "#{SupabaseAccessToken}"
            SupabaseCliVersion = "#{SupabaseCliVersion}"
            SupabaseDbPassword = "#{SupabaseDbPassword}"
            SupabaseProjectRef = "#{SupabaseProjectRef}"
        }
        worker_pool = "hosted-ubuntu"

        packages "supabase-migrations" {
            acquisition_location = "Server"
            feed = "octopus-server-built-in"
            package_id = "supabase-migrations"
            properties = {
                Extract = "True"
                SelectionMode = "immediate"
            }
        }
    }
}

step "supabase-deploy-edge-function" {
    name = "Supabase - Deploy Edge Function"

    action {
        properties = {
            Octopus.Action.Template.Id = "ActionTemplates-42"
            Octopus.Action.Template.Version = "1"
            SupabaseAccessToken = "#{SupabaseAccessToken}"
            SupabaseCliVersion = "latest"
            SupabaseDeployAll = "True"
            SupabaseProjectRef = "#{SupabaseProjectRef}"
            SupabaseSmokeTest = "False"
            SupabaseVerifyJWT = "True"
        }
        worker_pool = "hosted-ubuntu"

        packages "supabase-migrations" {
            acquisition_location = "Server"
            feed = "octopus-server-built-in"
            package_id = "supabase-migrations"
            properties = {
                Extract = "True"
                SelectionMode = "immediate"
            }
        }
    }
}